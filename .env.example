# PesaMarkets Environment Configuration Template
# Duplicate this file as .env and fill in your production credentials

# Django Core Security
SECRET_KEY=your-super-secret-django-production-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ==========================================
# Email Delivery Settings (SMTP / SendGrid / SES / Mailgun)
# When EMAIL_HOST is provided, real OTP emails are dispatched over SMTP.
# If omitted during development, Django outputs to the console securely.
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PesaMarkets Security <security@pesamarkets.com>

# ==========================================
# SMS Verification Gateway Configuration
# Optional: If the trader enters a mobile number during registration,
# OTP verification is sent via SMS in addition to their email.
# ==========================================
# 1. Twilio SMS Integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 2. Africa's Talking SMS Integration (East Africa / M-PESA Region)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ==========================================
# Social Single Sign-On (Google, Apple ID)
# ==========================================
# Google OAuth 2.0 Credentials (From Google Cloud Console: APIs & Services > Credentials)
# When set, "Sign in with Google" redirects directly to https://accounts.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple ID OAuth 2.0 Credentials (From Apple Developer Portal)
# When set, "Sign in with Apple" redirects directly to https://appleid.apple.com
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

